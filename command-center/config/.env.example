# 生成: python main.py env-template（アカウントは accounts_master.json から動的に展開）
# 値は config/.env に書く。.env は git に入れない。

# GitHub Actions では既存 Secret REI_AFFSAKU を ANTHROPIC_API_KEY として渡している
ANTHROPIC_API_KEY=

# 既存 Secret と同じ形式も読める: THREADS_ACCOUNTS=[{"name":"さくら","token":"..."},{"name":"AKIRA","token":"..."}]
THREADS_ACCOUNTS=

# ---- 既存 GitHub Secrets と同名（settings.credentials.global_fallback_account のアカウントで使う）
WP_USER=
WP_APP_PASSWORD=
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
THREADS_ACCESS_TOKEN=

# ---- AKIRA (akira_life_500)  稼働: note, x, threads, instagram
NOTE_EMAIL__AKIRA_LIFE_500=
NOTE_PASSWORD__AKIRA_LIFE_500=
X_API_KEY__AKIRA_LIFE_500=
X_API_SECRET__AKIRA_LIFE_500=
X_ACCESS_TOKEN__AKIRA_LIFE_500=
X_ACCESS_TOKEN_SECRET__AKIRA_LIFE_500=
X_BEARER_TOKEN__AKIRA_LIFE_500=
THREADS_ACCESS_TOKEN__AKIRA_LIFE_500=
THREADS_USER_ID__AKIRA_LIFE_500=
IG_ACCESS_TOKEN__AKIRA_LIFE_500=
IG_USER_ID__AKIRA_LIFE_500=

